# =====================================================================
# .env 模板：复制为 .env 并填入真实值（copy .env.example .env）
# 同名变量以系统环境变量优先（容器平台注入的环境变量 > .env 文件）；
# 修改后需重启 Daphne 生效。
#
# 标注说明：
#   【生产必填】不配会在生产环境留下隐患（安全/功能缺陷），上线前逐项确认
#   【推荐】     不配也能跑，但配了更好（性能/体验）
#   【可选】     按需
# =====================================================================

# -------- 核心安全 --------
# 【生产必填】Django 密钥。生产必须换成长随机串，否则 session/CORS/令牌可被伪造。
#   生成：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   不设时使用开发默认值（仅限本地 DEBUG=1）。
DJANGO_SECRET_KEY=
# 【生产必填】调试开关。生产必须为 0（DEBUG=1 会泄露堆栈与配置，且静态文件不走 WhiteNoise）。
DJANGO_DEBUG=1
# 【生产必填】允许的 Host（生产填你的域名，如 api.example.com；多个逗号分隔）。
#   默认 * 仅适合本地/测试。
DJANGO_ALLOWED_HOSTS=*

# -------- 数据库（三选一，按部署场景） --------
# ① 本地/单机容器：都不配，用 SQLite（库文件位置受 DATA_DIR 控制）
# ② 云 Postgres（Neon/Supabase/自建）：配 DATABASE_URL（标准 URL 格式，优先级最高）
#    DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# ③ 传统 Postgres 参数方式（无 DATABASE_URL 时生效）
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# 【容器部署必填】持久卷挂载点。SQLite 库 + media 都落这里，容器重建不丢。
#   注意：同时配 DATABASE_URL（PG）时只挪 MEDIA_ROOT，不动 PG 连接。
DATA_DIR=

# -------- 跨域与代理 --------
# 【生产必填】前端站点地址（CF Pages 域名等；多个逗号分隔）。不配则生产跨域全拒。
CORS_ALLOWED_ORIGINS=
# 【生产必填】CSRF 信任域（前后端域名都要含；多个逗号分隔）。
CSRF_TRUSTED_ORIGINS=

# -------- AI 大模型（不配则全部 AI 能力自动降级本地实现，不影响其他功能） --------
# 【NVIDIA NIM】https://build.nvidia.com 注册 → Get API Key（nvapi- 开头）
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1   （/v1 后缀必须带上）
#   模型示例：nvidia/nemotron-3-super-120b-a12b（实测 ~1s）、deepseek-ai/deepseek-v4-flash-0731
#   提示：推理模型可加 LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}} 提速
# 【DeepSeek 官方】LLM_BASE_URL=https://api.deepseek.com/v1   模型：deepseek-chat
# 【OpenAI】       LLM_BASE_URL=https://api.openai.com/v1    模型：gpt-4o-mini
# 【本地 vLLM】    LLM_BASE_URL=http://127.0.0.1:8000/v1     模型：按你部署的填
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}
LLM_TIMEOUT=90
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# -------- 文件上传 --------
FILE_MAX_SIZE_MB=1024
FILE_CHUNK_SIZE_MB=5
# 回收站保留天数（到期可由清理任务清除）
TRASH_KEEP_DAYS=30

# -------- Office 转 PDF（外部依赖，缺失时接口返回结构化提示而非 500） --------
# 未安装 LibreOffice 时留空自动探测；探测不到按平台提示安装。
SOFFICE_PATH=
OFFICE_CONVERT_TIMEOUT=120

# -------- 全文搜索 --------
SEARCH_ENABLED=1
SEARCH_MAX_TEXT_CHARS=200000
# 可索引文件大小上限（MB）
SEARCH_FILE_MAX_MB=20

# -------- 实时通道（多实例部署推荐配 Redis；单进程用内存层即可） --------
# 配了 REDIS_URL 后 Channels 走 RedisChannelLayer，多副本 WS 互通
REDIS_URL=

# -------- 认证与令牌 --------
# Access token 有效期（小时）
JWT_ACCESS_HOURS=12

# -------- 数据权限与多租户（默认关闭，向后兼容） --------
# 行级写权限严格按 owner 收口；应急回滚可设 0（不推荐）
WRITE_SCOPE_STRICT=1
# 多租户隔离总开关（默认 0：单人/单团队部署保持原行为）
TENANCY_ENABLED=0

# -------- 首次部署种子账号（seed 命令用；不配则默认 admin/admin123） --------
# 【生产必填】生产环境必须改掉默认密码！
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
