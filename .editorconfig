# 跨 IDE 一致性配置（S3-B1/D8）
# 优先级低于各编辑器本地设置；新克隆仓库按此文件统一风格。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{js,vue,ts,json,css,scss}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Markdown 保留行尾双空格语义（换行），不 trim
trim_trailing_whitespace = false

[*.vue]
indent_size = 2
